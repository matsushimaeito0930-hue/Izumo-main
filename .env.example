NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_WEBHOOK_SECRET=

# GitHubログイン（OAuth App）
# 未設定の場合はログインなしの手入力フローで動きます。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# セッションcookieの署名鍵。openssl rand -hex 32 などで生成してください。
AUTH_SECRET=
# 本番など、コールバックURLを固定したい場合のみ設定します。
# GITHUB_OAUTH_CALLBACK_URL=https://your-domain.example/api/auth/github/callback

# 役割のallowlist（GitHubユーザー名をカンマ区切り）
MENTOR_GITHUB_LOGINS=
ADMIN_GITHUB_LOGINS=

ENABLE_DEMO_MODE=true
EXPRESS_PORT=4000
