NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_WEBHOOK_SECRET=

# GitHubログイン（OAuth App）
# 未設定の場合はログインなしの手入力フローで動きます。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# セッションcookieの署名鍵。openssl rand -hex 32 などで生成してください。
AUTH_SECRET=
# 本番など、コールバックURLを固定したい場合のみ設定します。
# GITHUB_OAUTH_CALLBACK_URL=https://your-domain.example/api/auth/github/callback

# WakaTime OAuth（個人・チームの開発時間集計）
WAKATIME_CLIENT_ID=
WAKATIME_CLIENT_SECRET=
# WAKATIME_OAUTH_CALLBACK_URL=https://your-domain.example/api/auth/wakatime/callback

# 運営のallowlist（GitHubユーザー名をカンマ区切り）。ここに無い人は全員参加者。
# ADMIN_GITHUB_LOGINS is obsolete: roles are scoped to each event.

# Webhookの自動登録先。本番ドメインを入れてください（末尾スラッシュなし）。
# 未設定ならリクエストのオリジンから組み立てます。
APP_BASE_URL=

ENABLE_DEMO_MODE=true
EXPRESS_PORT=4000
